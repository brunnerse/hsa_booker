{
	"manifest_version": 2,
	"name": "HSA Booker",
	"description": "Automatically books and fills out booking form for booking sport courses of the HSA",
	"version": "1.3.7",

	"permissions": [
		"storage", "*://anmeldung.sport.uni-augsburg.de/*"
	],
	
	"browser_specific_settings": {
 		"gecko": {
			"id": "hsabooker@webext.de",
			"data_collection_permissions": {
				"required": [ "none" ],
				"optional": []
			}
		}
	},

	"icons": {
		"16": "img/favicon.png"
  	},

	"content_scripts": [
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/*"
			],
			"exclude_matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/aktueller_zeitraum/_*"
			],
			"js": [
				"scripts/common.js",
				"scripts/course_modify_page.js",
				"scripts/common_users.js", "scripts/common_course.js", 
				"scripts/course_overview.js"
			]
		},
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/aktueller_zeitraum/_*"
			],
			"js": [
				"scripts/common.js",
				"scripts/course_modify_page.js",
				"scripts/common_users.js", "scripts/common_course.js", 
				"scripts/course.js"
			]
		},
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/cgi/*"
			],
			"js": [
				"scripts/common.js", "scripts/common_users.js", 
				"scripts/anmeldung.js"
			]
		}
	],
	
	"web_accessible_resources": [
		"styles/hsabooker.css", 
		"Users.html", 
		"html/customelements.html", 
		"html/checkpopupsallowed.html", 
		"scripts/close.js"
	],

	"browser_action": {
		"default_icon": "img/favicon.png",
 		"default_title": "HSA Booker",
		"default_popup": "popup.html"
	},

	"options_ui": {
		"page": "options.html",
 		"open_in_tab": false
	}

}
