{
	"manifest_version": 3,
	"name": "HSA Booker",
	"description": "Automatically books and fills out booking form for booking sport courses of the HSA",
	"version": "1.3.6",

	"icons": {
		"16": "img/favicon.png"
  	},

	"content_scripts": [
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/*"
			],
			"exclude_matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/aktueller_zeitraum/_*"
			],
			"js": [
				"scripts/course_modify_page.js",
				"scripts/common.js", "scripts/common_users.js", "scripts/common_course.js", 
				"scripts/course_overview.js"
			]
		},
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/angebote/aktueller_zeitraum/_*"
			],
			"js": [
				"scripts/course_modify_page.js", 
				"scripts/common.js", "scripts/common_users.js", "scripts/common_course.js", 
				"scripts/course.js"
			]
		},
		{
			"matches": [
				"*://anmeldung.sport.uni-augsburg.de/cgi/*"
			],
			"js": [
				"scripts/common.js", "scripts/common_users.js", 
				"scripts/anmeldung.js"
			]
		}
	],

	"permissions": [
		"storage"
	],

	"host_permissions": [
		"*://anmeldung.sport.uni-augsburg.de/*"
	],

	"web_accessible_resources": [
		{
			"resources": ["styles/hsabooker.css", "Users.html", "checkpopupsallowed.html", "scripts/close.js"],
			"matches": [ "*://*/*" ]
		}
	],

	"action": {
		"default_popup": "popup.html"
	},

	"options_ui": {
		"page": "options.html",
 		"open_in_tab": false
	} 
}
